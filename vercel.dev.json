{
  "buildCommand": "cd src && npm run build",
  "outputDirectory": "src/build",
  "installCommand": "cd src && npm install",
  "framework": "sveltekit",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "src/build/**/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "env": {
    "NODE_ENV": "development"
  }
}
